---
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '../styles/global.css';

import plexArabic400 from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import { getImage } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ogSource from '../assets/og-image.png';
import logoSource from '../assets/logo-full.png';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsApp from '../components/StickyWhatsApp.astro';
import CardTilt from '../components/CardTilt.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site, type Locale } from '../config/site';
import { business, telUrl } from '../data/business';
import { businessId as businessIdFor } from '../lib/schema';

interface Props {
  lang: Locale;
  title: string; // ≤60 chars
  description: string; // ≤155 chars
  /** Locale-agnostic path, e.g. '' for home or 'packages' — same slug in both languages. */
  path: string;
  /** False for pages without a language pair (404): skips canonical + hreflang. */
  alternates?: boolean;
  /** The 404 page: noindex, and no JSON-LD at all. */
  notFound?: boolean;
  /** Extra JSON-LD objects (Service, FAQPage, BreadcrumbList). */
  schema?: object[];
  /** Prefilled WhatsApp message for this page's buttons. */
  waMessage?: string;
}

const { lang, title, description, path, alternates = true, notFound = false, schema = [] } = Astro.props;
const waMessage =
  Astro.props.waMessage ?? (lang === 'ar' ? 'السلام عليكم، أرغب بالاستفسار عن خدمات أمان.' : "Hello, I'd like to ask about Aman's services.");
const dir = lang === 'ar' ? 'rtl' : 'ltr';

const urlFor = (locale: Locale) => new URL(getRelativeLocaleUrl(locale, path), Astro.site).href;
const canonical = urlFor(lang);
const ogImage = await getImage({ src: ogSource, width: 1200, height: 630, format: 'png' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const logo = await getImage({ src: logoSource, width: 512, format: 'png' });
const logoUrl = new URL(logo.src, Astro.site).href;
// One stable id per entity, shared by both languages, so search engines see one business and one site.
const businessId = businessIdFor(Astro.site);
const websiteId = new URL('/#website', Astro.site).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': businessId,
  name: business.brand[lang],
  alternateName: business.brand[lang === 'ar' ? 'en' : 'ar'],
  legalName: business.legalName[lang],
  identifier: { '@type': 'PropertyValue', propertyID: 'CR', value: business.crNumber },
  slogan: business.tagline[lang],
  url: new URL(getRelativeLocaleUrl(lang, ''), Astro.site).href,
  image: ogImageUrl,
  logo: logoUrl,
  telephone: telUrl().replace('tel:', ''),
  areaServed: { '@type': 'City', name: business.areaServed[lang] },
  // Booking hours, assumed daily (schema needs days). No Review or AggregateRating, ever.
  openingHours: `Mo-Su ${business.hours.opens}-${business.hours.closes}`,
  knowsLanguage: ['en', 'ar'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.areaServed.en,
    addressCountry: business.countryCode,
  },
};

// Home pages only.
const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: business.brand[lang],
  alternateName: business.brand[lang === 'ar' ? 'en' : 'ar'],
  url: new URL(getRelativeLocaleUrl(lang, ''), Astro.site).href,
  inLanguage: lang === 'ar' ? 'ar-SA' : 'en',
  publisher: { '@id': businessId },
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBF7F0" />
    {!site.isLive ? <meta name="robots" content="noindex, nofollow" /> : notFound && <meta name="robots" content="noindex" />}

    {
      alternates && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="ar" href={urlFor('ar')} />
          <link rel="alternate" hreflang="en" href={urlFor('en')} />
          <link rel="alternate" hreflang="x-default" href={urlFor('ar')} />
        </>
      )
    }

    <link rel="preload" href={plexArabic400} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.brand[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {(notFound ? [] : [localBusiness, ...(path === '' ? [webSite] : []), ...schema]).map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-cream-100 text-ink-900 antialiased">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-green-700 px-4 py-2 text-cream-50 focus:not-sr-only focus:fixed focus:start-4 focus:top-4"
    >
      {lang === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content'}
    </a>
    <AnnouncementBar lang={lang} />
    <Header lang={lang} path={path} waMessage={waMessage} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} waMessage={waMessage} />
    <StickyWhatsApp lang={lang} message={waMessage} />
    <CookieBanner lang={lang} />
    <CardTilt />
  </body>
</html>

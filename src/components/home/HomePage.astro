    moreHelpTitle: 'ومساعدة أكثر في البيت',
    moreTitle: 'والمزيد',
    moreText: 'تحتاجون شيئاً آخر في البيت؟ اسألونا، وغالباً نجد له حلاً.',
    moreCta: 'اسألونا عبر واتساب',
    comboTitle: 'زيارة واحدة، مهام كثيرة',
    comboText: 'بدلاً من التنسيق مع أكثر من شخص، شخص واحد من فريق الرعاية يجمع ما يحتاجه بيتكم.',
    comboCta: 'احجزوا خدمتكم',
    comboHint: 'اختاروا الخدمات والتوقيت، ونجهّز لكم طلب الحجز على واتساب.',
    combos: [
      { a: 'babysitting', b: 'home-cleaning', text: 'الأطفال يلعبون، والبيت يترتب' },
      { a: 'elderly-companionship', b: 'pick-up-drop-off', text: 'صحبة في البيت، ومرافقة إلى المواعيد' },
      { a: 'pet-sitting', b: 'errands', text: 'مسافرون؟ الحيوانات والمقاضي في رعايتنا' },
    ],
    pkgTitle: 'باقات واضحة',
    pkgText: 'بالساعة أو بالأسبوع أو بالشهر. الخطط الأطول أقل سعراً للساعة.',
    pkgAll: 'كل الباقات',
    stepsTitle: 'كيف نبدأ؟',
    steps: [
      { t: 'راسلونا على واتساب', d: 'أخبرونا بالخدمة والموعد وعدد الأطفال أو احتياجات البيت.' },
      { t: 'نرشّح الشخص المناسب', d: 'نختار من فريقنا من يناسب عائلتكم، ونؤكد التفاصيل والسعر.' },
      { t: 'نصلكم في الموعد', d: 'نتعرّف على بيتكم وروتينكم، وتبدأ الرعاية.' },
    ],
    trustTitle: 'تطمئنون قبل أن نصل',
    trustText: 'كل فرد في فريقنا يخضع للتحقق من الخلفية قبل أن يدخل أي بيت. ونسأل عن قواعد بيتكم قبل أول زيارة، ونلتزم بها.',
    trustAlt: 'مقدّمة رعاية في بيت عائلة سعودية',
    trustPoints: ['التحقق من الخلفية لكل فرد في الفريق', `مقدّمو الرعاية يتحدثون ${business.languages.ar}`, 'نلتزم بقواعد بيتكم وخصوصيتكم', 'تحديثات على واتساب أثناء الزيارة'],
    firstTitle: 'كونوا من أوائل عائلاتنا',
    firstText: 'أمان في بداية رحلتها. لا نعرض تقييمات لم نكسبها بعد؛ نفضّل أن نكسب ثقتكم زيارة بعد زيارة.',
    firstCta: 'احجزوا أول زيارة',
    faqTitle: 'أسئلة شائعة',
    closeTitle: 'راحتكم أولويتنا',
    closeText: 'رسالة واحدة على واتساب، والباقي علينا.',
  },
  en: {
    h1: 'A trusted pair of hands at home, for everyone you love',
    lead: 'Newborn and mother care, babysitting, home cleaning, company for your parents, and cat and dog sitting in Riyadh. One caregiver can combine several services in a single visit.',
    trust: ['Background-checked staff', 'One caregiver, several services', 'Book directly on WhatsApp'],
    trustLabel: 'Why Aman',
    heroAlt: 'Aman logo: a mother holding her baby inside a heart',
    servicesTitle: 'Our services',
    servicesText: 'Choose one service, or combine several with a single caregiver.',
    moreHelpTitle: 'More help at home',
    moreTitle: 'And more',
    moreText: "Need something else done at home? Ask us; we'll usually find a way.",
    moreCta: 'Ask us on WhatsApp',
    comboTitle: 'One visit, many jobs done',
    comboText: 'Instead of coordinating several people, one caregiver brings together what your home needs.',
    comboCta: 'Book Your Service',
    comboHint: "Pick the services and timing, and we'll prepare your booking request on WhatsApp.",
    combos: [
      { a: 'babysitting', b: 'home-cleaning', text: 'The children play, the house gets tidy' },
      { a: 'elderly-companionship', b: 'pick-up-drop-off', text: 'Company at home, and a ride to appointments' },
      { a: 'pet-sitting', b: 'errands', text: 'Travelling? Pets and shopping, handled' },
    ],
    pkgTitle: 'Clear packages',
    pkgText: 'By the hour, the week or the month. Longer plans cost less per hour.',
    pkgAll: 'All packages',
    stepsTitle: 'How it works',
    steps: [
      { t: 'Message us on WhatsApp', d: 'Tell us the service, the time, and about your children or home.' },
      { t: 'We match a caregiver', d: 'We choose the right person from our team and confirm the details and price.' },
      { t: 'They arrive on time', d: 'They learn your home and routine, and care begins.' },
    ],
    trustTitle: 'Peace of mind before we arrive',
    trustText: 'Everyone on our team is background-checked before they enter any home. We ask about your house rules before the first visit, and we keep them.',
    trustAlt: 'A caregiver in a Saudi family home',
    trustPoints: ['Background checks for every team member', `Caregivers speak ${business.languages.en}`, 'Your house rules and privacy, respected', 'WhatsApp updates during the visit'],
    firstTitle: 'Be among our first families',
    firstText: "Aman is just beginning. We won't show reviews we haven't earned yet; we'd rather earn your trust one visit at a time.",
    firstCta: 'Book your first visit',
    faqTitle: 'Common questions',
    closeTitle: 'Your comfort, our priority',
    closeText: 'One WhatsApp message, and we take it from there.',
  },
}[lang];

const teaser = ['hourly-babysitting', 'monthly-6', 'stay-in'].map((id) => packages.find((p) => p.id === id)!);
---

<!-- Hero. Phones: headline, trust points, buttons, then the photo. Desktop: text and buttons beside the
     photo, with the trust points as a strip underneath. -->
<section class="relative isolate overflow-hidden">
  <HeroBackdrop />
  <div class="container-x grid gap-8 pb-16 pt-10 md:pt-16 lg:grid-cols-[1.1fr_1fr] lg:gap-x-16 lg:gap-y-8 lg:pb-20">
    <div class="rise lg:col-start-1 lg:row-start-1 lg:self-end">
      <h1 class="max-w-[16ch] text-4xl text-green-800 sm:text-5xl lg:text-6xl">{c.h1}</h1>
      <p class="mt-6 max-w-xl text-lg text-ink-600">{c.lead}</p>
    </div>

    <ul class="rise grid gap-3 sm:grid-cols-3 lg:col-span-2 lg:row-start-3 lg:gap-6 lg:border-t lg:border-gold-500/25 lg:pt-8" aria-label={c.trustLabel}>
      {
        c.trust.map((t, i) => (
          <li class="flex items-center gap-3 text-sm font-medium text-ink-700">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-cream-50 text-green-700 shadow-soft">
              <Icon name={(['shield', 'hands', 'whatsapp'] as const)[i]} class="size-5" />
            </span>
            {t}
          </li>
        ))
      }
    </ul>

    <div class="rise grid gap-3 sm:flex sm:flex-wrap lg:col-start-1 lg:row-start-2 lg:self-start">
      <a href={whatsappUrl(lang === 'ar' ? 'السلام عليكم، أرغب بحجز خدمة من أمان.' : "Hello, I'd like to book a service with Aman.")} rel="noopener" class="btn btn-primary min-h-14 px-8 text-base" data-hero-cta>
        <Icon name="whatsapp" class="size-6 text-gold-200" />
        {ui.bookWhatsApp[lang]}
      </a>
      <a href={href(lang, 'packages')} class="btn btn-ghost min-h-14 px-8 text-base">{ui.seePackages[lang]}</a>
    </div>

    <div class="relative mx-auto w-full max-w-[18.75rem] rise [animation-delay:150ms] sm:max-w-sm lg:col-start-2 lg:row-span-2 lg:row-start-1">
      <HeartLine class="absolute -top-6 end-0 z-10 hidden w-48 text-gold-500 sm:block" />
      <div class="parallax">
        <Visual
          lang={lang}
          photo="hero"
          alt={c.heroAlt}
          art="logo"
          tone="cream"
          eager
          widths={[300, 600, 800]}
          sizes="(min-width: 640px) 384px, 300px"
          class="shadow-card"
        />
      </div>
      <!-- This season's offer, floating -->
      <a
        href={href(lang, 'offers')}
        class="absolute -bottom-6 -start-4 w-60 rounded-3xl bg-cream-50 p-5 shadow-float ring-1 ring-gold-500/20 transition-transform duration-300 hover:-translate-y-1 active:scale-[0.98] sm:-start-8 sm:w-64"
      >
        <span class="flex items-center gap-2 text-xs font-semibold text-gold-700">
          <Icon name={featured.icon} class="size-4" />
          {featured.event[lang]}
        </span>
        <span class="mt-2 block font-semibold leading-snug text-green-800">{featured.title[lang]}</span>
        {featured.endsAt && (
          <span class="mt-2 block text-xs text-ink-500">
            <Countdown lang={lang} endsAt={featured.endsAt} />
          </span>
        )}
      </a>
    </div>
  </div>
</section>

<!-- Services -->
<section id="services" class="scroll-mt-28 py-16 md:py-24">
  <div class="container-x">
    <div class="reveal max-w-2xl">
      <h2 class="text-3xl text-green-800 md:text-4xl">{c.servicesTitle}</h2>
      <p class="mt-3 text-ink-600">{c.servicesText}</p>
    </div>
    <ul class="reveal-group mt-10 grid gap-6">
      {featuredServices.map((s) => <li><ServiceCard lang={lang} service={s} size="featured" /></li>)}
    </ul>
    <ul class="reveal-group mt-6 grid gap-6 md:grid-cols-3">
      {coreServices.map((s) => <li><ServiceCard lang={lang} service={s} /></li>)}
    </ul>
    <h3 class="mt-16 text-2xl text-green-800">{c.moreHelpTitle}</h3>
    <ul class="reveal-group mt-6 grid gap-4 lg:grid-cols-3">
      {moreServices.map((s) => <li><ServiceCard lang={lang} service={s} size="compact" headingLevel="h4" /></li>)}
      <li class="lg:col-span-3">
        <div class="flex flex-col items-start gap-4 rounded-3xl border border-dashed border-gold-500/40 p-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <span class="flex size-12 items-center justify-center rounded-full bg-gold-50 text-gold-700">
              <Icon name="more" class="size-6" stroke={2.4} />
            </span>
            <div>
              <h4 class="text-xl text-green-800">{c.moreTitle}</h4>
              <p class="text-ink-600">{c.moreText}</p>
            </div>
          </div>
          <a href={whatsappUrl(lang === 'ar' ? 'السلام عليكم، لدي استفسار عن خدمة أخرى.' : 'Hello, I have a question about another service.')} rel="noopener" class="btn btn-ghost shrink-0">
            {c.moreCta}
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>

<!-- One caregiver, many jobs -->
<section class="bg-cream-200/60 py-16 md:py-24">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:items-center">
    <div>
      <h2 class="reveal text-3xl text-green-800 md:text-4xl">{c.comboTitle}</h2>
      <p class="mt-3 max-w-md text-ink-600">{c.comboText}</p>
      <a href={`${href(lang, 'packages')}#booking`} class="btn btn-primary mt-8">
        <Icon name="calendar" class="size-5" />
        {c.comboCta}
      </a>
      <p class="mt-3 max-w-md text-sm text-ink-500">{c.comboHint}</p>
    </div>
    <ul class="grid gap-3">
      {
        c.combos.map((combo) => (
          <li class="flex items-center gap-4 rounded-2xl bg-cream-50 p-4 ring-1 ring-green-700/5">
            <span class="flex -space-x-2 rtl:space-x-reverse">
              <span class="flex size-10 items-center justify-center rounded-full bg-green-700 text-cream-50 ring-2 ring-cream-50">
                <Icon name={serviceBySlug(combo.a).icon} class="size-5" />
              </span>
              <span class="flex size-10 items-center justify-center rounded-full bg-gold-500 text-green-950 ring-2 ring-cream-50">
                <Icon name={serviceBySlug(combo.b).icon} class="size-5" />
              </span>
            </span>
            <span>
              <span class="block text-sm text-ink-500">
                {serviceBySlug(combo.a).name[lang]} + {serviceBySlug(combo.b).name[lang]}
              </span>
              <span class="block font-medium text-green-800">{combo.text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- How it works -->
<section class="py-16 md:py-24">
  <div class="container-x grid items-center gap-12 lg:grid-cols-[2fr_3fr] lg:gap-16">
    {hasPhoto('how-it-works') && (
      <Visual lang={lang} photo="how-it-works" alt="" shape="square" sizes="(min-width: 1024px) 420px, 90vw" class="reveal order-last mx-auto w-full max-w-sm shadow-card lg:order-first lg:max-w-none" />
    )}
    <div>
      <h2 class="reveal text-3xl text-green-800 md:text-4xl">{c.stepsTitle}</h2>
      <ol class="reveal-group mt-10 grid gap-8 md:grid-cols-3">
        {
          c.steps.map((s, i) => (
            <li class="relative">
              <span class="flex size-12 items-center justify-center rounded-full border border-gold-500 font-display text-xl text-gold-700">
                {i + 1}
              </span>
              {i < 2 && <span class="absolute start-16 top-6 hidden h-px w-[calc(100%-4rem)] bg-gold-500/30 md:block" aria-hidden="true" />}
              <h3 class="mt-5 text-xl text-green-800">{s.t}</h3>
              <p class="mt-2 text-ink-600">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<!-- Packages teaser -->
<section id="packages" class="scroll-mt-28 bg-cream-200/60 py-16 md:py-24">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="reveal max-w-2xl">
        <h2 class="text-3xl text-green-800 md:text-4xl">{c.pkgTitle}</h2>
        <p class="mt-3 text-ink-600">{c.pkgText}</p>
      </div>
      <a href={href(lang, 'packages')} class="btn btn-ghost">
        {c.pkgAll}
        <Icon name="arrow" class="size-4" flip />
      </a>
    </div>
    <div class="reveal-group mt-10 grid gap-6 md:grid-cols-3">
      {teaser.map((p) => <PackageCard lang={lang} pkg={p} />)}
    </div>
  </div>
</section>

<!-- Trust + first families -->
<section class="py-16 md:py-24">
  <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    {/* The doorstep photo is a wide two-person scene: a wide frame keeps both faces (the arch cut them). */}
    {hasPhoto('trust') ? (
      <Visual lang={lang} photo="trust" alt={c.trustAlt} shape="rounded" sizes="(min-width: 1024px) 520px, 90vw" class="reveal w-full shadow-card" />
    ) : (
      <Visual lang={lang} photo="trust" alt={c.trustAlt} icon="shield" tone="pink" class="mx-auto w-full max-w-sm" />
    )}
    <div>
      <h2 class="reveal text-3xl text-green-800 md:text-4xl">{c.trustTitle}</h2>
      <p class="mt-4 text-ink-600">{c.trustText}</p>
      <ul class="mt-6 grid gap-3">
        {
          c.trustPoints.map((t) => (
            <li class="flex items-center gap-3 text-ink-700">
              <Icon name="check" class="size-5 text-gold-600" stroke={2} />
              {t}
            </li>
          ))
        }
      </ul>
      <div class="mt-10 grid items-center gap-6 rounded-3xl bg-cream-50 p-6 shadow-card ring-1 ring-gold-500/15 sm:grid-cols-[10rem_1fr]">
        {hasPhoto('first-families') && <Visual lang={lang} photo="first-families" alt="" shape="square" sizes="160px" class="w-32 sm:w-full" />}
        <div class:list={[!hasPhoto('first-families') && 'sm:col-span-2']}>
          <h3 class="text-xl text-green-800">{c.firstTitle}</h3>
          <p class="mt-2 text-ink-600">{c.firstText}</p>
          <a href={whatsappUrl(lang === 'ar' ? 'السلام عليكم، أرغب بحجز أول زيارة.' : "Hello, I'd like to book our first visit.")} rel="noopener" class="btn btn-primary mt-5">
            <Icon name="whatsapp" class="size-5" />
            {c.firstCta}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Reviews: renders nothing until 3+ consented reviews exist in src/data/reviews.ts -->
<Reviews lang={lang} />

<!-- FAQ: the first HOME_FAQ_COUNT questions from src/data/home.ts (the FAQPage schema matches). -->
<section id="faq" class="scroll-mt-28 bg-cream-200/60 py-16 md:py-24">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_2fr]">
    <h2 class="reveal text-3xl text-green-800 md:text-4xl">{c.faqTitle}</h2>
    <FAQ lang={lang} items={homeFaqShown} />
  </div>
</section>

<!-- Closing. The extra bottom padding keeps the sticky WhatsApp button clear of this CTA on phones. -->
<section class="pb-32 pt-20 text-center md:pb-40">
  <div class="container-x">
    <HeartLine class="mx-auto w-40 text-gold-500" />
    <h2 class="mt-6 text-4xl text-green-800 md:text-5xl">{c.closeTitle}</h2>
    <p class="mx-auto mt-4 max-w-md text-lg text-ink-600">{c.closeText}</p>
    <a href={whatsappUrl(lang === 'ar' ? 'السلام عليكم، أرغب بالتواصل مع أمان.' : "Hello, I'd like to talk to Aman.")} rel="noopener" class="btn btn-primary mt-8 min-h-14 px-8 text-base">
      <Icon name="whatsapp" class="size-6 text-gold-200" />
      {ui.bookWhatsApp[lang]}
    </a>
  </div>
</section>

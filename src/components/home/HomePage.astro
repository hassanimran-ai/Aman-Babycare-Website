---
// Home page body, shared by / and /en/. Copy is per language below.
// Order: hero → trust strip → services → one visit, many jobs → how it works → packages → trust → FAQ → closing.
// Seasonal offers live on /offers/ and the booking card on /packages/#booking.
// REVIEW-AR: Arabic copy is a first draft.
import Icon from '../Icon.astro';
import Visual from '../Visual.astro';
import HeartLine from '../HeartLine.astro';
import HeroBackdrop from '../HeroBackdrop.astro';
import Countdown from '../Countdown.astro';
import ServiceCard from '../ServiceCard.astro';
import PackageCard from '../PackageCard.astro';
import FAQ from '../FAQ.astro';
import Reviews from '../Reviews.astro';
import { whatsappUrl, type Locale } from '../../config/site';
import { coreServices, featuredServices, moreServices, serviceBySlug } from '../../data/services';
import { featuredOffer as featured } from '../../data/offers';
import { packages } from '../../data/packages';
import { href, ui } from '../../i18n/ui';
import { homeFaqShown } from '../../data/home';
import { business } from '../../data/business';
import { hasPhoto } from '../../lib/photos';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const c = {
  ar: {
    h1: 'يدٌ أمينة في بيتكم، لكل من تحبون',

---
// Floating WhatsApp button for mobile and tablet; desktop uses the header CTA.
import Icon from './Icon.astro';
import { whatsappUrl, type Locale } from '../config/site';
import { ui } from '../i18n/ui';

interface Props {
  lang: Locale;
  message: string;
}
const { lang, message } = Astro.props;
---

<a
  href={whatsappUrl(message)}
  rel="noopener"
  class="btn btn-primary fixed bottom-4 end-4 z-30 min-h-14 ps-5 pe-6 shadow-float lg:hidden"
>
  <Icon name="whatsapp" class="size-6 text-gold-200" />
  {ui.bookWhatsApp[lang]}
</a>

---
import Icon from './Icon.astro';
import { SHOW_DISCOUNTS, whatsappUrl, type Locale } from '../config/site';
import type { Package } from '../data/packages';
import { money, rate, ui } from '../i18n/ui';

interface Props {
  lang: Locale;
  pkg: Package;
  headingLevel?: 'h3' | 'h4';
}
const { lang, pkg: p, headingLevel: H = 'h3' } = Astro.props;
const message =
  lang === 'ar' ? `السلام عليكم، أرغب بالاستفسار عن باقة: ${p.name.ar}` : `Hello, I'd like to ask about the package: ${p.name.en}`;
const was = SHOW_DISCOUNTS ? p.was : undefined;
const saving = was && p.price ? was - p.price : 0;
---

<article class="flex h-full flex-col rounded-3xl bg-cream-50 p-6 shadow-soft ring-1 ring-green-700/5" data-tilt>
  <div class:list={['flex items-start', SHOW_DISCOUNTS && 'min-h-7']}>
    {
      saving > 0 && (
        <span class="shimmer rounded-full bg-gold-50 px-3 py-1 text-xs font-semibold text-gold-700 ring-1 ring-gold-500/30">
          {lang === 'ar' ? `وفّروا ${money(saving)} ${ui.sar.ar}` : `Save ${ui.sar.en} ${money(saving)}`}
        </span>
      )
    }
  </div>
  <H class:list={['text-lg text-green-800', SHOW_DISCOUNTS && 'mt-3']}>{p.name[lang]}</H>
  <p class="mt-1 text-sm text-ink-500">{p.detail[lang]}</p>

  {/* Price block sits on the card floor so figures line up across a row, whatever the title length. */}
  <div class="mt-auto pt-6">
    <div class="border-t border-green-700/10 pt-6">
      {
        p.price ? (
          <p class="flex flex-wrap items-start gap-x-2 gap-y-1">
            <span class:list={['pt-1 text-sm font-semibold text-gold-700', lang === 'en' ? 'order-first' : 'order-last']}>{ui.sar[lang]}</span>
            <span
              class:list={[
                'text-[2.75rem] leading-none text-green-700 tabular-nums',
                lang === 'en' ? 'font-display font-semibold tracking-[-0.02em]' : 'font-bold',
              ]}
            >
              {money(p.price)}
            </span>
            {was && (
              <span class="order-last self-end text-sm text-ink-500 line-through tabular-nums">
                <span class="sr-only">{ui.was[lang]} </span>
                {money(was)}
              </span>
            )}
          </p>
        ) : (
          <p class="text-xl font-semibold text-green-700">{ui.askPrice[lang]}</p>
        )
      }
      {
        p.perHour ? (
          <p class="mt-4 inline-flex rounded-full bg-cream-100 px-3 py-1 text-sm text-green-800 ring-1 ring-gold-500/25">
            {ui.from[lang]}&nbsp;<span class="font-semibold tabular-nums">{rate(p.perHour)}</span>&nbsp;{ui.sar[lang]} {ui.perHour[lang]}
          </p>
        ) : (
          // Same height as the rate chip, so a priced card without an hourly rate keeps its figure in line with its row.
          p.price && <p class="invisible mt-4 py-1 text-sm" aria-hidden="true">&nbsp;</p>
        )
      }
      {p.draft && <p class="mt-3 text-xs text-ink-500">* {ui.draftPrice[lang]}</p>}
    </div>
  </div>

  <div class="pt-6">
    <a href={whatsappUrl(message)} rel="noopener" class="btn btn-ghost w-full text-sm">
      <Icon name="whatsapp" class="size-5" />
      {ui.bookWhatsApp[lang]}
    </a>
  </div>
</article>

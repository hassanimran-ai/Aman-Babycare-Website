---
import Icon from './Icon.astro';
import { SHOW_DISCOUNTS, SHOW_PRICES, whatsappUrl, type Locale } from '../config/site';
import type { Package } from '../data/packages';
import { href, money, rate, ui } from '../i18n/ui';
import { anchorFor } from '../data/seo';

interface Props {
  lang: Locale;
  pkg: Package;
  headingLevel?: 'h3' | 'h4';
  /** The service page this card sits on: its own link is left out there. */
  current?: string;
}
const { lang, pkg: p, headingLevel: H = 'h3', current } = Astro.props;
const message =
  lang === 'ar' ? `السلام عليكم، أرغب بالاستفسار عن باقة: ${p.name.ar}` : `Hello, I'd like to ask about the package: ${p.name.en}`;
// SHOW_PRICES off: no figures at all, only "Price confirmed on WhatsApp".
const price = SHOW_PRICES ? p.price : null;
const perHour = SHOW_PRICES ? p.perHour : undefined;
const was = SHOW_DISCOUNTS ? p.was : undefined;
const saving = was && price ? was - price : 0;
---

<article class="flex flex-col md:h-full rounded-3xl bg-cream-50 p-6 shadow-soft max-md:rounded-2xl max-md:p-3 ring-1 ring-green-700/5" data-tilt>
  <div class:list={['flex items-start', SHOW_DISCOUNTS && 'min-h-7']}>
    {
      saving > 0 && (
        <span class="shimmer rounded-full bg-gold-50 px-3 py-1 text-xs font-semibold text-gold-700 ring-1 ring-gold-500/30">
          {lang === 'ar' ? `وفّروا ${money(saving)} ${ui.sar.ar}` : `Save ${ui.sar.en} ${money(saving)}`}
        </span>
      )
    }
  </div>
  <H class:list={['text-lg text-green-800 max-md:text-base', SHOW_DISCOUNTS && 'mt-3']}>{p.name[lang]}</H>
  <p class="mt-1 text-sm text-ink-500 max-md:text-xs">{p.detail[lang]}</p>
  {
    p.service !== current && (
      <a href={href(lang, `services/${p.service}`)} class="mt-1 inline-flex min-h-11 items-center gap-1 self-start text-sm font-semibold text-gold-800 hover:underline max-md:text-xs">
        {anchorFor(p.service, lang, p.service)}
        <Icon name="arrow" class="size-4 max-md:size-3.5" flip />
      </a>
    )
  }

  {/* Price block sits on the card floor so figures line up across a row, whatever the title length. */}
  <div class="mt-auto pt-6 max-md:pt-4">
    <div class="border-t border-green-700/10 pt-6 max-md:pt-4">
      {
        price ? (
          <p class="flex flex-wrap items-start gap-x-2 gap-y-1 max-md:gap-x-1">
            <span class:list={['pt-1 text-sm font-semibold text-gold-700 max-md:pt-0.5 max-md:text-xs', lang === 'en' ? 'order-first' : 'order-last']}>{ui.sar[lang]}</span>
            <span
              class:list={[
                'text-[2.75rem] leading-none text-green-700 tabular-nums max-md:text-[1.75rem]',
                lang === 'en' ? 'font-display font-semibold tracking-[-0.02em]' : 'font-bold',
              ]}
            >
              {money(price)}
            </span>
            {was && (
              <span class="order-last self-end text-sm text-ink-500 line-through max-md:text-xs tabular-nums">
                <span class="sr-only">{ui.was[lang]} </span>
                {money(was)}
              </span>
            )}
          </p>
        ) : (
          <p class="text-xl font-semibold text-green-700 max-md:text-base">{SHOW_PRICES ? ui.askPrice[lang] : ui.priceConfirmed[lang]}</p>
        )
      }
      {
        perHour ? (
          <p class="mt-4 inline-flex rounded-full bg-cream-100 px-3 py-1 text-sm text-green-800 ring-1 ring-gold-500/25 max-md:mt-3 max-md:inline-block max-md:rounded-xl max-md:px-2 max-md:text-xs">
            {ui.from[lang]}&nbsp;<span class="font-semibold tabular-nums">{rate(perHour)}</span>&nbsp;{ui.sar[lang]} {ui.perHour[lang]}
          </p>
        ) : (
          // Same height as the rate chip, so a priced card without an hourly rate keeps its figure in line with its row.
          price && <p class="invisible mt-4 py-1 text-sm max-md:mt-3 max-md:text-xs" aria-hidden="true">&nbsp;</p>
        )
      }
      {price && p.draft && <p class="mt-3 text-xs text-ink-500">* {ui.draftPrice[lang]}</p>}
    </div>
  </div>

  <div class="pt-6 max-md:pt-4">
    <a href={whatsappUrl(message)} rel="noopener" class="btn btn-ghost w-full text-sm max-md:min-h-11 max-md:gap-1.5 max-md:px-2 max-md:text-center max-md:text-xs max-md:leading-tight">
      <Icon name="whatsapp" class="size-5 max-md:size-4" />
      {ui.bookWhatsApp[lang]}
    </a>
  </div>
</article>

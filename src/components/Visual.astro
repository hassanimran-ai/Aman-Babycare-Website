---
// A framed visual. If src/assets/photos/<photo>.(jpg|jpeg|png|webp) exists it is shown;
// otherwise a branded line-art panel stands in (docs/build/imagery.md).
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';
import logoMark from '../assets/logo-mark.png';

interface Props {
  photo: string;
  alt: string;
  icon?: IconName;
  /** 'logo' shows the logo mark in the panel instead of an icon. */
  art?: 'icon' | 'logo';
  tone?: 'cream' | 'pink' | 'green';
  shape?: 'arch' | 'rounded' | 'square';
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  photo,
  alt,
  icon = 'heart',
  art = 'icon',
  tone = 'cream',
  shape = 'arch',
  eager = false,
  sizes = '(min-width: 1024px) 480px, 90vw',
  class: cls = '',
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === photo);
const image = match?.[1].default;

const panel = {
  cream: 'bg-cream-200 text-gold-600',
  pink: 'bg-pink-100 text-gold-600',
  green: 'bg-green-700 text-gold-300',
}[tone];
const shapeCls = {
  arch: 'arch aspect-[4/5]',
  rounded: 'rounded-[2rem] aspect-[16/10] overflow-hidden',
  square: 'rounded-2xl aspect-square overflow-hidden',
}[shape];
---

<div class:list={['relative isolate', shapeCls, cls]}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[400, 640, 960]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="size-full object-cover"
      />
    ) : (
      <div class:list={['flex size-full items-center justify-center', panel]} role="img" aria-label={alt}>
        {/* Najdi-style crenellation band along the base */}
        <svg class="absolute inset-x-0 bottom-0 h-10 w-full opacity-40" aria-hidden="true">
          <defs>
            <pattern id={`najdi-${photo}`} width="24" height="16" patternUnits="userSpaceOnUse">
              <path d="M0 16 12 4l12 12" fill="none" stroke="currentColor" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill={`url(#najdi-${photo})`} />
        </svg>
        {art === 'logo' ? (
          <Image src={logoMark} alt="" width={360} height={316} loading={eager ? 'eager' : 'lazy'} class="w-3/4 max-w-[22rem]" />
        ) : (
          <Icon name={icon} class="size-2/5" stroke={0.6} />
        )}
      </div>
    )
  }
</div>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import ServiceCard from '../ServiceCard.astro';
import Visual from '../Visual.astro';
import { hasPhoto } from '../../lib/photos';
import CtaBand from '../CtaBand.astro';
import type { Locale } from '../../config/site';
import { coreServices, featuredServices, moreServices } from '../../data/services';
import { href, ui } from '../../i18n/ui';
import { breadcrumbSchema } from '../../lib/schema';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const crumbs = [
  { name: ui.nav.home[lang], url: href(lang, '') },
  { name: ui.nav.services[lang], url: href(lang, 'services') },
];
// REVIEW-AR
const t = {
  ar: {
    title: 'خدمات أمان المنزلية في الرياض | أمان',
    description: 'رعاية المواليد والأمهات، رعاية الأطفال، مرافقة كبار السن، تنظيف المنازل، رعاية الحيوانات، التوصيل، والمشتريات في الرياض.',
    h1: 'كل ما يحتاجه بيتكم، مع فريق واحد',
    lead: 'سبع خدمات منزلية يمكن حجزها منفردة أو جمعها في زيارة واحدة مع مقدّمة رعاية واحدة.',
    moreHelp: 'ومساعدة أكثر في البيت',
    ctaTitle: 'لم تجدوا ما تبحثون عنه؟',
    ctaText: 'اسألونا على واتساب؛ كثير من الطلبات المنزلية يمكننا ترتيبها.',
  },
  en: {
    title: 'Home Services in Riyadh | Aman',
    description: 'Newborn and mother care, babysitting, elderly companionship, home cleaning, pet sitting, rides and errands in Riyadh. Book on WhatsApp.',
    h1: 'Everything your home needs, from one team',
    lead: 'Seven home services you can book on their own, or combine in a single visit with one caregiver.',
    moreHelp: 'More help at home',
    ctaTitle: "Can't find what you need?",
    ctaText: 'Ask us on WhatsApp; we can arrange many other jobs around the home.',
  },
}[lang];
---

<BaseLayout lang={lang} title={t.title} description={t.description} path="services" schema={[breadcrumbSchema(crumbs, Astro.site)]}>
  <Breadcrumbs lang={lang} items={crumbs} />
  <section class="container-x pb-16 pt-8 md:pb-24">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <h1 class="max-w-[20ch] text-4xl text-green-800 sm:text-5xl">{t.h1}</h1>
        <p class="mt-6 max-w-xl text-lg text-ink-600">{t.lead}</p>
      </div>
      {hasPhoto('services-hero') && <Visual lang={lang} photo="services-hero" alt="" shape="rounded" eager sizes="(min-width: 1024px) 560px, 90vw" class="shadow-card" />}
    </div>
    <ul class="reveal-group mt-12 grid gap-6">
      {featuredServices.map((s) => <li><ServiceCard lang={lang} service={s} size="featured" headingLevel="h2" /></li>)}
    </ul>
    <ul class="reveal-group mt-6 grid gap-6 md:grid-cols-3">
      {coreServices.map((s) => <li><ServiceCard lang={lang} service={s} headingLevel="h2" /></li>)}
    </ul>
    <h2 class="reveal mt-16 text-2xl text-green-800">{t.moreHelp}</h2>
    <ul class="reveal-group mt-6 grid gap-4 lg:grid-cols-3">
      {moreServices.map((s) => <li><ServiceCard lang={lang} service={s} size="compact" /></li>)}
    </ul>
  </section>
  <CtaBand
    lang={lang}
    tone="dark"
    title={t.ctaTitle}
    text={t.ctaText}
    message={lang === 'ar' ? 'السلام عليكم، لدي استفسار عن خدمة منزلية.' : 'Hello, I have a question about a home service.'}
    secondary={{ label: ui.seePackages[lang], url: href(lang, 'packages') }}
  />
  <div class="h-24 md:h-28" aria-hidden="true"></div>
</BaseLayout>

---
// Seasonal offers: this season's offer, the welcome offer, and the calendar of what's coming.
// Offers come only from src/data/offers.ts. REVIEW-AR: Arabic is a first draft.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Countdown from '../Countdown.astro';
import CtaBand from '../CtaBand.astro';
import Icon from '../Icon.astro';
import Visual from '../Visual.astro';
import { whatsappUrl, type Locale } from '../../config/site';
import { featuredOffer as featured, upcomingOffers } from '../../data/offers';
import { welcomeOffer } from '../../data/packages';
import { serviceBySlug } from '../../data/services';
import { href, ui } from '../../i18n/ui';
import { breadcrumbSchema } from '../../lib/schema';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const crumbs = [
  { name: ui.nav.home[lang], url: href(lang, '') },
  { name: ui.nav.offers[lang], url: href(lang, 'offers') },
];

const t = {
  ar: {
    title: 'عروض المواسم | أمان لرعاية المواليد والخدمات المنزلية',
    description: 'عروض أمان في الرياض لكل مناسبة: الجمعة البيضاء ورمضان والأعياد واليوم الوطني والعودة إلى المدارس، وعرض الترحيب لأول حجز.',
    h1: 'عروض المواسم',
    lead: 'لكل مناسبة في السنة باقة تناسبها. هذا عرض الموسم الحالي، وما ينتظركم بعده.',
    claim: 'احجزوا العرض عبر واتساب',
    includes: 'يشمل',
    welcomeTitle: 'أول زيارة لكم؟',
    calendar: 'تقويم العروض',
    ctaTitle: 'تفضّلون باقة ثابتة؟',
    ctaText: 'الباقات الشهرية والأسبوعية متاحة طوال السنة.',
  },
  en: {
    title: 'Seasonal offers | Aman Babycare & Home Services',
    description: "Aman's offers in Riyadh for every occasion: White Friday, Ramadan, Eid, National Day and back to school, plus a welcome offer for your first booking.",
    h1: 'Seasonal offers',
    lead: "Every occasion of the year has a bundle to match. Here's this season's offer, and what's coming next.",
    claim: 'Book this offer on WhatsApp',
    includes: 'Includes',
    welcomeTitle: 'Your first visit?',
    calendar: 'Offer calendar',
    ctaTitle: 'Prefer a steady plan?',
    ctaText: 'Weekly and monthly packages are available all year round.',
  },
}[lang];

const offerMessage = (event: string) =>
  lang === 'ar' ? `السلام عليكم، أرغب بالاستفادة من عرض ${event}.` : `Hello, I'd like to book the ${event} offer.`;
const welcomeMsg = lang === 'ar' ? `السلام عليكم، أرغب بـ${welcomeOffer.name.ar}.` : `Hello, I'd like the ${welcomeOffer.name.en}.`;
---

<BaseLayout lang={lang} title={t.title} description={t.description} path="offers" schema={[breadcrumbSchema(crumbs, Astro.site)]} waMessage={offerMessage(featured.event[lang])}>
  <Breadcrumbs lang={lang} items={crumbs} />
  <article class="container-x pb-16 pt-8 md:pb-24">
    <div class="max-w-2xl">
      <h1 class="text-4xl text-green-800 sm:text-5xl">{t.h1}</h1>
      <p class="mt-6 text-lg text-ink-600">{t.lead}</p>
    </div>

    <!-- Live offer -->
    <section aria-labelledby="offer-live" class="mt-10 grid grid-cols-[5rem_1fr] gap-x-4 gap-y-3 rounded-3xl bg-green-800 p-4 text-cream-100 shadow-card lg:grid-cols-[9rem_1fr_auto] lg:items-center lg:gap-x-6 lg:gap-y-2 lg:p-5">
      <Visual photo={`offer-${featured.id}`} alt="" icon={featured.icon} tone="green" shape="square" sizes="(min-width: 1024px) 144px, 80px" eager class="self-start lg:row-span-3 lg:self-center" />
      <div class="min-w-0 lg:self-end">
        <p class="flex flex-wrap items-center gap-x-2 text-xs font-semibold text-gold-300">
          <Icon name={featured.icon} class="size-4" />
          {featured.event[lang]}
          <span class="font-normal text-cream-200/80">{featured.when[lang]}</span>
        </p>
        <h2 id="offer-live" class="mt-1 text-lg leading-snug text-cream-50 lg:text-xl">{featured.title[lang]}</h2>
      </div>
      <p class="col-span-2 text-sm text-cream-200 lg:col-span-1 lg:col-start-2">{featured.text[lang]}</p>
      <div class="col-span-2 flex flex-wrap items-center gap-2 text-xs text-cream-200 lg:col-span-1 lg:col-start-2 lg:self-start">
        <span>{t.includes}:</span>
        {featured.services.map((s) => (
          <a href={href(lang, `services/${s}`)} class="inline-flex min-h-11 items-center rounded-full px-3 ring-1 ring-cream-50/20 hover:bg-cream-50/10 active:scale-[0.98]">
            {serviceBySlug(s).name[lang]}
          </a>
        ))}
        {featured.endsAt && (
          <span class="ms-auto inline-flex items-center gap-1 rounded-full bg-cream-50/10 px-3 py-1 text-cream-50 has-[[hidden]]:hidden lg:ms-2">
            <Icon name="clock" class="size-4 text-gold-300" />
            <Countdown lang={lang} endsAt={featured.endsAt} />
          </span>
        )}
      </div>
      <a href={whatsappUrl(offerMessage(featured.event[lang]))} rel="noopener" class="btn btn-light col-span-2 min-h-11 text-sm lg:col-span-1 lg:col-start-3 lg:row-span-3 lg:row-start-1">
        <Icon name="whatsapp" class="size-5" />
        {t.claim}
      </a>
    </section>

    <!-- Welcome offer -->
    <section aria-labelledby="offer-welcome" class="mt-3 flex items-center gap-3 rounded-3xl bg-pink-100 p-3 md:gap-4 md:px-5 md:py-4">
      <span class="hidden size-11 shrink-0 items-center justify-center rounded-full bg-cream-50 text-gold-700 sm:flex">
        <Icon name="gift" class="size-5" />
      </span>
      <div class="min-w-0 flex-1 ps-1 sm:ps-0">
        <h2 id="offer-welcome" class="text-sm text-green-800 md:text-base">{t.welcomeTitle} <span class="font-semibold text-ink-700">{welcomeOffer.name[lang]}</span></h2>
        <p class="text-xs text-ink-600 md:text-sm">{welcomeOffer.detail[lang]}</p>
      </div>
      <a href={whatsappUrl(welcomeMsg)} rel="noopener" class="btn btn-primary min-h-11 shrink-0 px-3 text-sm md:px-6" aria-label={`${ui.bookWhatsApp[lang]}: ${welcomeOffer.name[lang]}`}>
        <Icon name="whatsapp" class="size-5" />
        <span class="hidden md:inline">{ui.bookWhatsApp[lang]}</span>
      </a>
    </section>

    <!-- Calendar of upcoming offers -->
    <section aria-labelledby="offer-calendar" class="mt-16">
      <h2 id="offer-calendar" class="text-2xl text-green-800 md:text-3xl">{t.calendar}</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          upcomingOffers.map((o) => (
            <li class="flex items-center gap-3 rounded-2xl bg-cream-50 p-2.5 shadow-soft ring-1 ring-green-700/5">
              <Visual photo={`offer-${o.id}`} alt="" icon={o.icon} shape="square" sizes="64px" class="w-16 shrink-0" />
              <div class="min-w-0">
                <h3 class="flex items-center gap-1.5 text-sm font-semibold text-green-800">
                  <Icon name={o.icon} class="size-4 shrink-0 text-gold-600" />
                  {o.event[lang]}
                </h3>
                <p class="text-xs text-ink-500">
                  {o.when[lang]}
                  {o.hijri && ` (${ui.expected[lang]})`}
                </p>
                <p class="mt-0.5 text-xs text-ink-600">{o.title[lang]}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
  <CtaBand lang={lang} title={t.ctaTitle} text={t.ctaText} message={lang === 'ar' ? 'السلام عليكم، أرغب بالاستفسار عن الباقات.' : "Hello, I'd like to ask about your packages."} secondary={{ label: ui.seePackages[lang], url: href(lang, 'packages') }} />
  <div class="pb-16 md:pb-24"></div>
</BaseLayout>

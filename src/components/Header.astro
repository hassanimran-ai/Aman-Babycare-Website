---
// Header: logo lockup, glass-ribbon navigation, language + WhatsApp. Rules: docs/build/header-and-navigation.md
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import GlassRibbon, { type RibbonItem } from './GlassRibbon.astro';
import logoMark from '../assets/logo-mark.png';
import { site, whatsappUrl, type Locale } from '../config/site';
import { href, other, ui } from '../i18n/ui';

interface Props {
  lang: Locale;
  path: string;
  waMessage: string;
}

const { lang, path, waMessage } = Astro.props;
const alt = other(lang);
const home = href(lang, '');
// "Baby Care & Home Services" / "لرعاية المواليد والخدمات المنزلية": the full name minus the short name.
const sub = {
  en: site.name.en.replace(site.shortName.en, '').trim(),
  ar: site.name.ar.replace(site.shortName.ar, '').trim(),
};

// Offers sits in the middle so it draws the eye (client request).
const links: RibbonItem[] = [
  { label: ui.nav.home[lang], href: home, icon: 'home' },
  { label: ui.nav.services[lang], href: href(lang, 'services'), icon: 'hands' },
  { label: ui.nav.offers[lang], href: `${home}#offers`, icon: 'gift', accent: true, section: 'offers' },
  { label: ui.nav.packages[lang], href: href(lang, 'packages'), icon: 'calendar' },
  { label: ui.nav.faqShort[lang], href: `${home}#faq`, icon: 'chat', section: 'faq' },
];
const active = path === '' ? 0 : path.startsWith('services') ? 1 : path === 'packages' ? 3 : -1;
---

<!-- Phones/tablets: the logo row scrolls away (negative top) and the ribbon row stays stuck. -->
<header class="sticky -top-[4.5rem] z-40 border-b border-green-700/5 bg-cream-100/90 backdrop-blur-md lg:top-0">
  <div class="container-x flex flex-wrap items-center gap-x-4 lg:flex-nowrap">
    <div class="flex h-[4.5rem] items-center">
      <!-- Lockup mirrors brand_assets/Logo.png: name, English line, Arabic line. -->
      <a href={home} class="flex min-h-11 items-center gap-2 rounded-2xl sm:gap-3" aria-label={site.name[lang]}>
        <Image src={logoMark} alt="" width={52} height={46} densities={[2, 3]} loading="eager" class="h-11 w-auto sm:h-12" />
        <span class="flex flex-col" aria-hidden="true">
          <span class="flex items-center gap-1 leading-none">
            {
              lang === 'ar' ? (
                <span class="text-xl font-bold text-green-700">{site.shortName.ar}</span>
              ) : (
                <span class="font-display text-xl font-semibold tracking-[0.08em] text-green-700">{site.shortName.en.toUpperCase()}</span>
              )
            }
            <Icon name="heart" class="size-3.5 text-gold-500" stroke={2} />
          </span>
          {
            (lang === 'ar' ? (['ar', 'en'] as const) : (['en', 'ar'] as const)).map((l) => (
              <span lang={l} class:list={['whitespace-nowrap text-ink-600', l === 'en' ? 'text-[0.625rem] font-semibold leading-4 tracking-[0.04em] text-green-700' : 'text-[0.6875rem] leading-4']}>
                {sub[l]}
              </span>
            ))
          }
        </span>
      </a>
    </div>

    <GlassRibbon
      items={links}
      active={active}
      label={ui.mainNav[lang]}
      class="order-last mb-3 w-full lg:order-none lg:mx-auto lg:mb-0 lg:w-auto"
    />

    <div class="ms-auto flex items-center gap-2 lg:ms-0">
      <a
        href={href(alt, path)}
        hreflang={alt}
        lang={alt}
        class="flex min-h-11 items-center rounded-full px-3 text-sm font-semibold text-green-700 hover:bg-green-50 active:scale-[0.98]"
        title={ui.switchTo[lang]}
      >
        {alt === 'en' ? 'EN' : 'عربي'}
      </a>
      <a href={whatsappUrl(waMessage)} class="btn btn-primary hidden min-h-11 whitespace-nowrap px-4 text-sm lg:inline-flex xl:px-6" rel="noopener" aria-label={ui.bookWhatsApp[lang]}>
        <Icon name="whatsapp" class="size-5" />
        <span class="hidden xl:inline">{ui.bookWhatsApp[lang]}</span>
      </a>
    </div>
  </div>
</header>

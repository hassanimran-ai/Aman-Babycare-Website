---
// The fine gold swoosh from the logo's heart. Decorative. Draws itself in from the reading start (.draw in global.css).
interface Props {
  class?: string;
}
const { class: cls = 'w-40 text-gold-500' } = Astro.props;
---

<div class:list={[cls, 'draw']} aria-hidden="true">
  <div class="draw-mask">
    <svg viewBox="0 0 200 40" fill="none" class="block h-auto w-full rtl:-scale-x-100">
      <path
        d="M2 30C40 36 80 34 112 24c18-6 30-14 36-20 4-4 12-3 12 4 0 6-8 9-12 6-4-3-1-10 6-10 10 0 20 8 44 16"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      />
    </svg>
  </div>
</div>

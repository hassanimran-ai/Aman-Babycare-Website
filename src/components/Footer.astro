---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Skyline from './Skyline.astro';
import logoFull from '../assets/logo-full.png';
import { whatsappUrl, isPlaceholder, type Locale } from '../config/site';
import { business, telUrl } from '../data/business';
import { services } from '../data/services';
import { href, ui } from '../i18n/ui';
import { publishedPosts } from '../lib/blog';

interface Props {
  lang: Locale;
  waMessage: string;
}
const { lang, waMessage } = Astro.props;
const home = href(lang, '');
const year = new Date().getFullYear();
const contacts = [
  !isPlaceholder(business.email) && { label: business.email, url: `mailto:${business.email}` },
].filter(Boolean) as { label: string; url: string }[];
const operator =
  lang === 'ar'
    ? `${business.shortBrand.ar} — تشغيل ${business.legalName.ar} — السجل التجاري: ${business.crNumber}`
    : `${business.shortBrand.en} — operated by ${business.legalName.en} — CR: ${business.crNumber}`;
// business.sa verification badge: nothing renders until it is set in business.ts.
const badge = business.businessSaBadge;
// The blog link appears once a post is published (until then there is no /blog/ page).
const hasBlog = (await publishedPosts(lang)).length > 0;
---

<footer class="relative mt-auto bg-green-900 text-cream-200">
  <Skyline class="absolute inset-x-0 -top-px h-16 w-full -translate-y-full text-green-900/15 md:h-24" />
  <div class="container-x grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.2fr_1fr_0.8fr_1.2fr]">
    <div class="max-w-xs">
      <a href={home} class="inline-block rounded-3xl bg-cream-100 p-4" aria-label={business.brand[lang]}>
        <Image src={logoFull} alt="" aria-hidden="true" width={140} height={191} class="h-auto w-28" />
      </a>
      <p class="mt-6 text-sm leading-relaxed">{ui.serving[lang]}.</p>
    </div>

    <nav aria-label={ui.footerServices[lang]}>
      <h2 class="text-sm font-semibold text-gold-300">{ui.footerServices[lang]}</h2>
      <ul class="mt-4 grid gap-1 text-sm">
        {
          services.map((s) => (
            <li>
              <a href={href(lang, `services/${s.slug}`)} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">
                {s.name[lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={ui.footerExplore[lang]}>
      <h2 class="text-sm font-semibold text-gold-300">{ui.footerExplore[lang]}</h2>
      <ul class="mt-4 grid gap-1 text-sm">
        <li><a href={home} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">{ui.nav.home[lang]}</a></li>
        <li><a href={href(lang, 'services')} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">{ui.nav.services[lang]}</a></li>
        <li><a href={href(lang, 'packages')} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">{ui.nav.packages[lang]}</a></li>
        <li><a href={href(lang, 'offers')} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">{ui.nav.offers[lang]}</a></li>
        <li><a href={`${home}#faq`} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">{ui.nav.faq[lang]}</a></li>
        {hasBlog && <li><a href={href(lang, 'blog')} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">{lang === 'ar' ? 'المدونة' : 'Blog'}</a></li>}
        <li><a href={href(lang, 'about')} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">{ui.nav.about[lang]}</a></li>
        <li><a href={href(lang, 'contact')} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">{ui.nav.contact[lang]}</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold text-gold-300">{ui.footerContact[lang]}</h2>
      <a href={whatsappUrl(waMessage)} rel="noopener" class="btn btn-light mt-4 whitespace-nowrap">
        <Icon name="whatsapp" class="size-5" />
        {ui.chatWhatsApp[lang]}
      </a>
      {
        !isPlaceholder(business.phone) && (
          <a href={telUrl()} class="mt-4 flex min-h-11 items-center gap-2 text-sm hover:text-cream-50 hover:underline">
            <Icon name="phone" class="size-4 text-gold-300" />
            <span>{ui.callUs[lang]}: <span dir="ltr">{business.phone}</span></span>
          </a>
        )
      }
      {contacts.map((c) => <a href={c.url} class="mt-1 block text-sm hover:text-cream-50">{c.label}</a>)}
      <p class="mt-1 text-sm">{business.areaServed[lang]}{lang === 'ar' ? '، ' : ', '}{business.country[lang]}</p>
    </div>
  </div>
  <div class="border-t border-cream-50/10">
    <div class="container-x flex flex-col gap-2 py-6 pb-24 text-xs text-cream-200/80 sm:flex-row sm:items-center sm:justify-between lg:pb-6">
      <div class="grid gap-1">
        <p>© {year} {business.brand[lang]}. {ui.rights[lang]}.</p>
        <p>{operator}</p>
        {
          badge && (
            <a href={badge.url} rel="noopener" class="mt-2 inline-flex min-h-11 items-center">
              <img src={badge.image} alt={lang === 'ar' ? 'موثّق في المركز السعودي للأعمال' : 'Verified on the Saudi Business Center'} class="h-12 w-auto" loading="lazy" />
            </a>
          )
        }
      </div>
      <p class="flex flex-wrap items-center gap-x-4">
        <a href={href(lang, 'privacy')} class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline">{ui.nav.privacy[lang]}</a>
        <button type="button" class="inline-flex min-h-11 items-center hover:text-cream-50 hover:underline active:scale-[0.98]" data-cookie-settings>
          {lang === 'ar' ? 'إعدادات ملفات الارتباط' : 'Cookie settings'}
        </button>
        <span>{business.tagline[lang]}</span>
      </p>
    </div>
  </div>
</footer>

---
// Riyadh skyline line drawing (Kingdom Centre, Al Faisaliah). Decorative. Draws itself in on scroll (.draw in global.css).
interface Props {
  class?: string;
}
const { class: cls = 'w-full text-gold-400/50' } = Astro.props;
---

<div class:list={[cls, 'draw']} aria-hidden="true">
  <div class="draw-mask h-full">
    <svg viewBox="0 0 1200 170" fill="none" preserveAspectRatio="xMidYMax meet" class="block size-full">
      <g stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
        <path d="M0 168h1200" />
        <!-- low-rise -->
        <path d="M60 168v-34h40v34M110 168v-52h28v52M150 168v-40h46v40M210 168v-62h24v62M246 168v-44h52v44" />
        <path d="M320 168v-70h30v70M362 168v-50h44v50M420 168v-86h26v86M458 168v-58h40v58M512 168v-40h30v40" />
        <!-- Kingdom Centre -->
        <path d="M556 168c3-50 7-100 12-150h8c6 34 14 52 24 52s18-18 24-52h8c5 50 9 100 12 150" />
        <path d="M572 18c-1-4 0-6 4-6M628 18c1-4 0-6-4-6M592 120h16M590 140h20" />
        <path d="M664 168v-54h36v54M712 168v-74h28v74M752 168v-46h34v46" />
        <!-- Al Faisaliah -->
        <path d="M790 168l32-138 32 138M806 98h32M822 30V10" />
        <circle cx="822" cy="70" r="9" />
        <path d="M870 168v-60h30v60M912 168v-42h46v42M970 168v-80h24v80M1006 168v-50h40v50M1058 168v-36h34v36M1104 168v-58h28v58M1144 168v-30h40v30" />
      </g>
    </svg>
  </div>
</div>

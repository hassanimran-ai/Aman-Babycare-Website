---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="ar"
  title="الصفحة غير موجودة | أمان"
  description="الصفحة التي تبحث عنها غير موجودة. عد إلى الصفحة الرئيسية لموقع أمان."
  path="404"
  alternates={false}
>
  <main class="mx-auto max-w-5xl px-4 py-24 text-center">
    <h1 class="text-4xl font-bold text-green-600">الصفحة غير موجودة</h1>
    <p class="mt-4 text-ink-700" lang="en" dir="ltr">Page not found.</p>
    <div class="mt-8 flex justify-center gap-6">
      <a class="text-green-600 underline" href="/">الصفحة الرئيسية</a>
      <a class="text-green-600 underline" href="/en/" lang="en">Home (English)</a>
    </div>
  </main>
</BaseLayout>

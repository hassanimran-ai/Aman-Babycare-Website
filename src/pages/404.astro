---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeartLine from '../components/HeartLine.astro';
---

<BaseLayout
  lang="ar"
  title="الصفحة غير موجودة | أمان"
  description="الصفحة التي تبحث عنها غير موجودة. عد إلى الصفحة الرئيسية لموقع أمان."
  path="404"
  alternates={false}
>
  <section class="container-x py-24 pb-40 text-center">
    <HeartLine class="mx-auto w-40 text-gold-500" />
    <h1 class="mt-6 text-4xl text-green-800">الصفحة غير موجودة</h1>
    <p class="mt-4 text-ink-600">ربما تغيّر الرابط. هذه أهم الصفحات:</p>
    <p class="mt-1 text-ink-500" lang="en" dir="ltr">This page doesn't exist. Here are the main pages:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href="/">الصفحة الرئيسية</a>
      <a class="btn btn-ghost" href="/services/">الخدمات</a>
      <a class="btn btn-ghost" href="/en/" lang="en">Home (English)</a>
    </div>
  </section>
</BaseLayout>

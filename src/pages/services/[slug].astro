---
import ServicePage from '../../components/service/ServicePage.astro';
import { services, type ServiceContent } from '../../data/services';

export const getStaticPaths = () => services.map((s) => ({ params: { slug: s.slug }, props: { content: s } }));
const { content } = Astro.props as { content: ServiceContent };
---

<ServicePage lang="ar" content={content} />

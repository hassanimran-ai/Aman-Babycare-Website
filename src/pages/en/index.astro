---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/home/HomePage.astro';
import { faqSchema } from '../../lib/schema';
import { homeFaqShown } from '../../data/home';
import { seo, tr } from '../../data/seo';
---

<BaseLayout
  lang="en"
  title={tr(seo.home.title, 'en')}
  description={tr(seo.home.description, 'en')}
  path=""
  schema={[faqSchema('en', homeFaqShown)]}
>
  <HomePage lang="en" />
</BaseLayout>

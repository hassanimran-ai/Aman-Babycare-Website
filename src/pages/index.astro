---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
  lang="ar"
  title="أمان | رعاية المواليد والخدمات المنزلية في الرياض"
  description="رعاية المواليد ومجالسة الأطفال وتنظيف المنازل ومرافقة كبار السن في الرياض. احجز عبر واتساب."
  path=""
>
  <!-- REVIEW-AR -->
  <main class="mx-auto max-w-5xl px-4 py-24">
    <h1 class="text-4xl font-bold text-green-600">{site.name.ar}</h1>
    <p class="mt-4 text-ink-700">الموقع قيد الإنشاء.</p>
    <a class="mt-8 inline-block text-green-600 underline" href="/en/" hreflang="en" lang="en">English</a>
  </main>
</BaseLayout>

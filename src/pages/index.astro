---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/home/HomePage.astro';
import { faqSchema } from '../lib/schema';
import { homeFaqShown } from '../data/home';
import { seo, tr } from '../data/seo';
---

<BaseLayout
  lang="ar"
  title={tr(seo.home.title, 'ar')}
  description={tr(seo.home.description, 'ar')}
  path=""
  schema={[faqSchema('ar', homeFaqShown)]}
>
  <!-- REVIEW-AR -->
  <HomePage lang="ar" />
</BaseLayout>
